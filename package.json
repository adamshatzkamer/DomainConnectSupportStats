{
  "name": "domainconnect-support-stats",
  "private": true,
  "version": "0.22.1",
  "type": "module",
  "description": "Static statistics site for Domain Connect support across DNS providers, built from the DomainConnectScanner export",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:export": "node scripts/validate-export.ts",
    "validate:registry": "node scripts/validate-registry.ts",
    "contract:registry": "node scripts/contract-registry.ts",
    "bundle:data": "node scripts/bundle-data.ts",
    "bundle:registry": "node scripts/bundle-registry.ts",
    "derive": "node scripts/derive-data.ts",
    "check:version": "node scripts/check-version.ts",
    "release:notes": "node scripts/release-notes.ts",
    "verify": "npm run lint && npm run check && npm run check:version && npm test && npm run build && npm run test:e2e"
  }
}
