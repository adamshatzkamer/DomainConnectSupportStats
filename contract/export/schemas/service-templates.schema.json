{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/DomainConnectScanner/docs/schemas/service-templates.schema.json",
  "title": "report.py service-templates --output-mode json",
  "description": "One table of every stored template (service provider + service id), including templates no DNS provider has been probed for yet (every count 0), at most --limit rows. Support counts are current state; reach describes the selected import, named in the note.",
  "$ref": "common.schema.json#/$defs/report",
  "properties": {
    "notes": { "$ref": "common.schema.json#/$defs/shareNotes" },
    "tables": {
      "properties": {
        "service_templates": {
          "properties": {
            "title": { "type": "string" },
            "columns": {
              "prefixItems": [
                { "properties": { "key": { "const": "provider_name" } } },
                { "properties": { "key": { "const": "provider_id" } } },
                { "properties": { "key": { "const": "service_name" } } },
                { "properties": { "key": { "const": "service_id" } } },
                { "properties": { "key": { "const": "added_at" } } },
                { "properties": { "key": { "const": "total" } } },
                { "properties": { "key": { "const": "supported_count" } } },
                { "properties": { "key": { "const": "supported_pct" } } },
                { "properties": { "key": { "const": "unsupported_count" } } },
                { "properties": { "key": { "const": "unsupported_pct" } } },
                { "properties": { "key": { "const": "undetermined_count" } } },
                { "properties": { "key": { "const": "undetermined_pct" } } },
                { "properties": { "key": { "const": "reach_domains" } } },
                { "properties": { "key": { "const": "reach_pct" } } }
              ],
              "minItems": 14,
              "items": false
            },
            "rows": {
              "description": "Ordered by reach_domains (descending) when a domain share is selected, otherwise by supported_count descending. Empty when there are none.",
              "items": { "$ref": "#/$defs/row" }
            },
            "footer": { "type": "null" }
          }
        }
      },
      "required": ["service_templates"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "row": {
      "allOf": [
        { "$ref": "#/$defs/publicRow" }
      ],
      "unevaluatedProperties": false
    },
    "publicRow": {
      "description": "A row's public columns - the static export's row (docs/schemas/export/service-templates.schema.json).",
      "type": "object",
      "allOf": [{ "$ref": "common.schema.json#/$defs/publicSupportBucketColumns" }],
      "properties": {
        "provider_name": { "description": "Service provider name, falling back to its id.", "type": "string" },
        "provider_id": { "description": "Service provider id (Domain Connect providerId).", "type": "string" },
        "service_name": { "description": "Template name, falling back to the service id.", "type": "string" },
        "service_id": { "type": "string" },
        "added_at": {
          "description": "When the template was added to the repository; null when unknown.",
          "$ref": "common.schema.json#/$defs/nullableTimestamp"
        },
        "total": {
          "description": "Every DNS provider that can be asked (a template-support API, or any answer); 0 when there is no such provider - never whether probes exist (GitHub issue #271).",
          "$ref": "common.schema.json#/$defs/count"
        },
        "reach_domains": {
          "description": "Domains behind the DNS providers counted in supported_count, in the selected import; null without a domain share.",
          "$ref": "common.schema.json#/$defs/nullableCount"
        },
        "reach_pct": {
          "description": "reach_domains as a percentage of the import's scanned domains.",
          "$ref": "common.schema.json#/$defs/nullablePercentage"
        }
      },
      "required": [
        "provider_name",
        "provider_id",
        "service_name",
        "service_id",
        "added_at",
        "total",
        "reach_domains",
        "reach_pct"
      ]
    }
  }
}
