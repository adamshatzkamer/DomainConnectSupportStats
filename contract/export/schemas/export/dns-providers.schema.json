{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/DomainConnectScanner/docs/schemas/export/dns-providers.schema.json",
  "title": "export.py dns-providers.json",
  "description": "The static export's DNS provider list: report.py dns-providers' JSON with every row (no --limit), for the manifest's share_import. Each row's dns_provider_id names its card, dns-providers/{dns_provider_id}.json. Like every export file, it starts with the release's generated_at (the manifest's).",
  "$ref": "../common.schema.json#/$defs/exportFile",
  "properties": {
    "notes": { "$ref": "../common.schema.json#/$defs/shareNotes" },
    "tables": {
      "properties": {
        "dns_providers": {
          "properties": {
            "title": { "type": "string" },
            "columns": {
              "prefixItems": [
                { "properties": { "key": { "const": "name" } } },
                { "properties": { "key": { "const": "dns_provider_id" } } },
                { "properties": { "key": { "const": "provider_id" } } },
                { "properties": { "key": { "const": "api_host" } } },
                { "properties": { "key": { "const": "settings_status" } } },
                { "properties": { "key": { "const": "support_status" } } },
                { "properties": { "key": { "const": "support_answered" } } },
                { "properties": { "key": { "const": "support_failed" } } },
                { "properties": { "key": { "const": "total" } } },
                { "properties": { "key": { "const": "supported_count" } } },
                { "properties": { "key": { "const": "supported_pct" } } },
                { "properties": { "key": { "const": "unsupported_count" } } },
                { "properties": { "key": { "const": "unsupported_pct" } } },
                { "properties": { "key": { "const": "undetermined_count" } } },
                { "properties": { "key": { "const": "undetermined_pct" } } },
                { "properties": { "key": { "const": "supported_templates_change" } } },
                { "properties": { "key": { "const": "supported_templates_change_90d" } } },
                { "properties": { "key": { "const": "with_version_count" } } },
                { "properties": { "key": { "const": "full_template_count" } } },
                { "properties": { "key": { "const": "morphed_count" } } },
                { "properties": { "key": { "const": "outdated_count" } } },
                { "properties": { "key": { "const": "domains" } } },
                { "properties": { "key": { "const": "domains_pct" } } }
              ],
              "minItems": 21,
              "items": false
            },
            "rows": {
              "description": "Ordered by domains (descending, unmeasured last) when a domain share is selected, otherwise by supported_count descending, then name. Empty when there are no DNS providers.",
              "items": {
                "$ref": "../dns-providers.schema.json#/$defs/publicRow",
                "unevaluatedProperties": false
              }
            },
            "footer": { "type": "null" }
          }
        }
      },
      "required": ["dns_providers"],
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
