{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/DomainConnectScanner/docs/schemas/export/dns-provider-summary.schema.json",
  "title": "export.py dns-providers/{dns_provider_id}.json",
  "description": "One DNS provider's card: report.py dns-provider-summary's JSON (--dns-provider-id) for a row of dns-providers.json, for the manifest's share_import, redacted - the provider record leaves out its pipeline bookkeeping (dns_provider_key, throttle_key, last_checked_at, settings_last_checked_at, support_last_checked_at) and the support table the internal pending/failed buckets. Always found (a card exists only for a listed id), so always all seven tables and only the share note. Like every export file, it starts with the release's generated_at (the manifest's).",
  "$ref": "../common.schema.json#/$defs/exportFile",
  "properties": {
    "notes": { "$ref": "../common.schema.json#/$defs/shareNotes" },
    "tables": {
      "properties": {
        "provider": { "$ref": "#/$defs/metadataTable" },
        "support": { "$ref": "#/$defs/supportTable" },
        "share": { "$ref": "../dns-provider-summary.schema.json#/$defs/shareTable" },
        "urls": { "$ref": "../dns-provider-summary.schema.json#/$defs/urlsTable" },
        "supported_templates": { "$ref": "../dns-provider-summary.schema.json#/$defs/templatesTable" },
        "support_history": { "$ref": "../dns-provider-summary.schema.json#/$defs/templateHistoryTable" },
        "share_history": { "$ref": "../dns-provider-summary.schema.json#/$defs/shareHistoryTable" }
      },
      "required": ["provider", "support", "share", "urls", "supported_templates", "support_history", "share_history"],
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "metadataTable": {
      "description": "The stored dns_providers row's public fields as one record: one row, always these columns in this order. Redacted: no pipeline bookkeeping, no settings_raw.",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "id" } } },
            { "properties": { "key": { "const": "name" } } },
            { "properties": { "key": { "const": "provider_id" } } },
            { "properties": { "key": { "const": "domain_connect_url" } } },
            { "properties": { "key": { "const": "api_url" } } },
            { "properties": { "key": { "const": "sync_url" } } },
            { "properties": { "key": { "const": "async_url" } } },
            { "properties": { "key": { "const": "control_panel_url" } } },
            { "properties": { "key": { "const": "nameservers" } } },
            { "properties": { "key": { "const": "first_seen_at" } } },
            { "properties": { "key": { "const": "settings_last_status" } } },
            { "properties": { "key": { "const": "settings_last_error" } } },
            { "properties": { "key": { "const": "settings_last_seen_ok_at" } } },
            { "properties": { "key": { "const": "support_last_status" } } },
            { "properties": { "key": { "const": "support_last_error" } } },
            { "properties": { "key": { "const": "support_last_seen_ok_at" } } }
          ],
          "minItems": 16,
          "items": false
        },
        "rows": {
          "$ref": "../common.schema.json#/$defs/oneRow",
          "items": {
            "$ref": "../dns-provider-summary.schema.json#/$defs/publicMetadataRow",
            "unevaluatedProperties": false
          }
        },
        "footer": { "type": "null" }
      }
    },
    "supportTable": {
      "description": "The provider's probe combinations on record and their published support breakdown: one row. Redacted: total - supported - unsupported is not yet determined.",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "total" } } },
            { "properties": { "key": { "const": "supported_count" } } },
            { "properties": { "key": { "const": "supported_pct" } } },
            { "properties": { "key": { "const": "unsupported_count" } } },
            { "properties": { "key": { "const": "unsupported_pct" } } },
            { "properties": { "key": { "const": "supported_templates" } } },
            { "properties": { "key": { "const": "unsupported_templates" } } },
            { "properties": { "key": { "const": "undetermined_templates" } } }
          ],
          "minItems": 8,
          "items": false
        },
        "rows": {
          "$ref": "../common.schema.json#/$defs/oneRow",
          "items": {
            "$ref": "../dns-provider-summary.schema.json#/$defs/publicSupportRow",
            "unevaluatedProperties": false
          }
        },
        "footer": { "type": "null" }
      }
    }
  }
}
