{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/DomainConnectScanner/docs/schemas/export/stack-summary.schema.json",
  "title": "export.py stacks/{provider_id}.json",
  "description": "One stack's card: report.py stack-summary's JSON (--provider-id) for a row of stacks.json, for the manifest's share_import, redacted - the deployments table leaves out the internal pending/failed support buckets. Always found (a card exists only for a listed id), so always all four tables and only the share note. Like every export file, it starts with the release's generated_at (the manifest's).",
  "$ref": "../common.schema.json#/$defs/exportFile",
  "properties": {
    "notes": { "$ref": "../common.schema.json#/$defs/shareNotes" },
    "tables": {
      "properties": {
        "stack": { "$ref": "../stack-summary.schema.json#/$defs/stackTable" },
        "deployments": { "$ref": "#/$defs/deploymentsTable" },
        "template_coverage": { "$ref": "../stack-summary.schema.json#/$defs/coverageTable" },
        "share_history": { "$ref": "../stack-summary.schema.json#/$defs/shareHistoryTable" }
      },
      "required": ["stack", "deployments", "template_coverage", "share_history"],
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "deploymentsTable": {
      "description": "The stack's deployments (dns_providers rows declaring its providerId), each its report.py dns-providers row without provider_id. Redacted.",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "name" } } },
            { "properties": { "key": { "const": "dns_provider_id" } } },
            { "properties": { "key": { "const": "api_host" } } },
            { "properties": { "key": { "const": "settings_status" } } },
            { "properties": { "key": { "const": "support_status" } } },
            { "properties": { "key": { "const": "total" } } },
            { "properties": { "key": { "const": "supported_count" } } },
            { "properties": { "key": { "const": "supported_pct" } } },
            { "properties": { "key": { "const": "unsupported_count" } } },
            { "properties": { "key": { "const": "unsupported_pct" } } },
            { "properties": { "key": { "const": "supported_templates" } } },
            { "properties": { "key": { "const": "supported_templates_change" } } },
            { "properties": { "key": { "const": "supported_templates_change_90d" } } },
            { "properties": { "key": { "const": "unsupported_templates" } } },
            { "properties": { "key": { "const": "undetermined_templates" } } },
            { "properties": { "key": { "const": "domains" } } },
            { "properties": { "key": { "const": "domains_pct" } } }
          ],
          "minItems": 17,
          "items": false
        },
        "rows": {
          "description": "Ordered like report.py dns-providers: by domains (descending) when a domain share is selected, otherwise by supported templates descending. At least one row.",
          "minItems": 1,
          "items": {
            "$ref": "../stack-summary.schema.json#/$defs/publicDeploymentRow",
            "unevaluatedProperties": false
          }
        },
        "footer": { "type": "null" }
      }
    }
  }
}
