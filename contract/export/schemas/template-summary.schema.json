{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawel-kow/DomainConnectScanner/docs/schemas/template-summary.schema.json",
  "title": "report.py template-summary --output-mode json",
  "description": "Every template of --service-provider-id (only --service-id when given), ordered by service id, each as four tables in turn - metadata, records, supporting DNS providers, support history - keyed '<service provider id>/<service id>/metadata|records|supporters|history'. No tables, and a second note, when no template matches. Support is current state; domains/reach_pct describe the selected import (--import-id, default the newest completed one), named in the first note.",
  "$ref": "common.schema.json#/$defs/report",
  "properties": {
    "notes": {
      "type": "array",
      "prefixItems": [{ "type": "string" }],
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 2
    },
    "tables": {
      "patternProperties": {
        "^[^/]+/[^/]+/metadata$": { "$ref": "#/$defs/metadataTable" },
        "^[^/]+/[^/]+/records$": { "$ref": "#/$defs/recordsTable" },
        "^[^/]+/[^/]+/supporters$": { "$ref": "#/$defs/supportersTable" },
        "^[^/]+/[^/]+/history$": { "$ref": "#/$defs/historyTable" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "metadataTable": {
      "description": "The newest stored version's services row, plus every stored version, as one record: one row, one column per field, always these fields in this order (txt/markdown show it transposed, one line per field).",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "service_provider_name" } } },
            { "properties": { "key": { "const": "service_provider_id" } } },
            { "properties": { "key": { "const": "service_id" } } },
            { "properties": { "key": { "const": "name" } } },
            { "properties": { "key": { "const": "version" } } },
            { "properties": { "key": { "const": "versions" } } },
            { "properties": { "key": { "const": "description" } } },
            { "properties": { "key": { "const": "variable_description" } } },
            { "properties": { "key": { "const": "logo_url" } } },
            { "properties": { "key": { "const": "template_sha" } } },
            { "properties": { "key": { "const": "created_at" } } },
            { "properties": { "key": { "const": "updated_at" } } }
          ],
          "minItems": 12,
          "items": false
        },
        "rows": { "$ref": "common.schema.json#/$defs/oneRow", "items": { "$ref": "#/$defs/metadataRow" } },
        "footer": { "type": "null" }
      }
    },
    "metadataRow": {
      "type": "object",
      "properties": {
        "service_provider_name": { "$ref": "common.schema.json#/$defs/nullableString" },
        "service_provider_id": { "type": "string" },
        "service_id": { "type": "string" },
        "name": { "$ref": "common.schema.json#/$defs/nullableString" },
        "version": { "description": "The newest stored version, the one described here.", "type": "integer", "minimum": 0 },
        "versions": { "description": "Every stored version, newest first.", "allOf": [{ "$ref": "common.schema.json#/$defs/versions" }], "minItems": 1 },
        "description": { "description": "Free text from the template; may span several lines.", "$ref": "common.schema.json#/$defs/nullableString" },
        "variable_description": { "$ref": "common.schema.json#/$defs/nullableString" },
        "logo_url": { "$ref": "common.schema.json#/$defs/nullableString" },
        "template_sha": { "description": "Git blob SHA of the template file at the last sync.", "$ref": "common.schema.json#/$defs/nullableString" },
        "created_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "updated_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" }
      },
      "required": [
        "service_provider_name",
        "service_provider_id",
        "service_id",
        "name",
        "version",
        "versions",
        "description",
        "variable_description",
        "logo_url",
        "template_sha",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "recordsTable": {
      "description": "The template's records as published in the Domain Connect Templates repo, one row each. The columns are the keys the records use (key and header alike: the template field name verbatim), known ones first (type, groupId, host, pointsTo, data, target, ttl), then the rest alphabetically; a key a record lacks is null. No rows when no records are stored.",
      "properties": {
        "title": { "type": "string" },
        "columns": { "type": "array" },
        "rows": {
          "items": {
            "type": "object",
            "properties": { "type": { "type": ["string", "null"] } },
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          }
        },
        "footer": { "type": "null" }
      }
    },
    "supportersTable": {
      "description": "DNS providers currently supporting any version of the template - as many as there are rows.",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "name" } } },
            { "properties": { "key": { "const": "dns_provider_id" } } },
            { "properties": { "key": { "const": "provider_id" } } },
            { "properties": { "key": { "const": "api_host" } } },
            { "properties": { "key": { "const": "versions" } } },
            { "properties": { "key": { "const": "since" } } },
            { "properties": { "key": { "const": "domains" } } },
            { "properties": { "key": { "const": "reach_pct" } } }
          ],
          "minItems": 8,
          "items": false
        },
        "rows": {
          "description": "Ordered by domains (descending) with a domain share, by name otherwise.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "providerName, falling back to the first Domain Connect URL, then '?'.",
                "type": "string"
              },
              "dns_provider_id": {
                "description": "dns_providers.id - the --dns-provider-id of report.py dns-provider-summary.",
                "$ref": "common.schema.json#/$defs/id"
              },
              "provider_id": {
                "description": "The provider's stack (providerId); null when it declares none.",
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "api_host": {
                "description": "Host of the provider's urlAPI; null when it declares none.",
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "versions": {
                "description": "Template versions this provider supports, ascending.",
                "allOf": [{ "$ref": "common.schema.json#/$defs/versions" }],
                "minItems": 1
              },
              "since": {
                "description": "When this provider first supported any version of the template (support_history), as report.py dns-provider-summary's supported_templates since: version changes and gaps do not restart it. null if the event log has no record of it.",
                "$ref": "common.schema.json#/$defs/nullableTimestamp"
              },
              "domains": { "$ref": "common.schema.json#/$defs/nullableCount" },
              "reach_pct": { "$ref": "common.schema.json#/$defs/nullablePercentage" }
            },
            "required": ["name", "dns_provider_id", "provider_id", "api_host", "versions", "since", "domains", "reach_pct"],
            "additionalProperties": false
          }
        },
        "footer": {
          "description": "TOTAL over the rows (exact: each URL belongs to one provider); domains and reach_pct are null without a domain share.",
          "type": "object",
          "properties": {
            "name": { "description": "The footer's label (display text, 'TOTAL' today).", "type": "string" },
            "dns_provider_id": { "type": "null" },
            "provider_id": { "type": "null" },
            "api_host": { "type": "null" },
            "versions": { "type": "null" },
            "since": { "type": "null" },
            "domains": { "$ref": "common.schema.json#/$defs/nullableCount" },
            "reach_pct": { "$ref": "common.schema.json#/$defs/nullablePercentage" }
          },
          "required": ["name", "dns_provider_id", "provider_id", "api_host", "versions", "since", "domains", "reach_pct"],
          "additionalProperties": false
        }
      }
    },
    "historyTable": {
      "description": "One row per support sweep covering this template (not ones scoped to a single DNS provider), oldest first: how many DNS providers supported it once that sweep had run.",
      "properties": {
        "title": { "type": "string" },
        "columns": {
          "prefixItems": [
            { "properties": { "key": { "const": "sweep_id" } } },
            { "properties": { "key": { "const": "started_at" } } },
            { "properties": { "key": { "const": "completed_at" } } },
            { "properties": { "key": { "const": "supporting_providers" } } },
            { "properties": { "key": { "const": "change" } } }
          ],
          "minItems": 5,
          "items": false
        },
        "rows": {
          "items": {
            "type": "object",
            "allOf": [{ "$ref": "common.schema.json#/$defs/sweepHistoryRow" }],
            "properties": { "supporting_providers": { "$ref": "common.schema.json#/$defs/count" } },
            "required": ["supporting_providers"],
            "unevaluatedProperties": false
          }
        },
        "footer": { "type": "null" }
      }
    }
  }
}
